    },
    {
      "$ref": "#/$defs/app_core_contracts__BigQueryPublishReceipt"
    },
    {
      "$ref": "#/$defs/app_core_contracts__LearningReceipt"
    }
  ],
  "title": "PreM3 run state contracts"
}
