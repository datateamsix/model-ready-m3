# Copy to .env for local development. Do not commit .env.
# Local ADK uses Application Default Credentials, not a service-account key:
#   %APPDATA%\gcloud\application_default_credentials.json
# Do not set GOOGLE_APPLICATION_CREDENTIALS or GOOGLE_API_KEY.
# Cloud Run will use M3_RUNTIME_SA instead of your user ADC.

# Google Cloud
GOOGLE_CLOUD_PROJECT=modelready-m3
GOOGLE_CLOUD_PROJECT_NUMBER=912257136465
# Vertex Gemini endpoint (global reduces 429 capacity contention)
GOOGLE_CLOUD_LOCATION=global
# Buckets, BigQuery datasets, and Cloud Run stay regional
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Runtime identity — Cloud Run attaches this service account. Do not deploy as a human Owner.
M3_RUNTIME_SA=m3-runtime@modelready-m3.iam.gserviceaccount.com
MODELREADY_CLOUD_RUN_SERVICE=modelready-m3

# Gemini / ADK — Vertex publisher IDs only (not AI Studio aliases)
M3_GEMINI_MODEL=gemini-2.5-flash
M3_AGENT_NAME=modelready_m3

# ModelReady tenancy (single synthetic tenant for hackathon)
MODELREADY_ORGANIZATION_ID=music-center
MODELREADY_WORKSPACE_ID=mmm-demo

# Storage — uniform bucket-level access in us-central1
# RAW: immutable incoming packages
# ARTIFACTS: normalized data, reports, manifests, provenance, receipts
MODELREADY_RAW_BUCKET=modelready-m3-912257136465-raw
MODELREADY_ARTIFACT_BUCKET=modelready-m3-912257136465-artifacts

# BigQuery — dataset IDs, not fully-qualified table names
MODELREADY_BQ_OPS_DATASET=modelready_ops
MODELREADY_BQ_EXPERIENCE_DATASET=modelready_experience
MODELREADY_BQ_MODELS_DATASET=modelready_models

# Runtime
MODELREADY_ENV=dev
MODELREADY_LOG_LEVEL=INFO

# Isolated Meridian EDA Cloud Run Job (not installed in the ADK service image)
MODELREADY_EDA_JOB=meridian-eda-worker
MODELREADY_EDA_JOB_TIMEOUT=3300
