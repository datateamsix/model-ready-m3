flowchart TD
    task[Completed assignment] --> closeEp[close_experience_episode]
    closeEp --> episode[ExperienceEpisode]
    episode --> reflect[ExperienceReflection]
    reflect --> extract[Candidate extraction]
    extract --> candidate[CandidateLesson]
    candidate --> eval[Deterministic evaluation]
    eval --> constraints[Constraints / policy]
    constraints --> reject[REJECT]
    constraints --> hold[HOLD_FOR_MORE_EVIDENCE]
    constraints --> promote[PROMOTE]
    reject --> evidence[Evidence retained]
    hold --> evidence
    promote --> staged[STAGED DOMAIN_VIEW]
    staged --> regress[Regression]
    regress --> activate[Activate DOMAIN_VIEW vN+1]
    activate --> learned[EXPERIENCE_LEARNED]
    learned --> future[Later independent assignment]
    future --> retrieve[Learned claim retrieved]
    retrieve --> changed{Behavior changed?}
    changed -->|no| noApply[NO EXPERIENCE_APPLIED]
    changed -->|yes| validate[Independent validation]
    validate -->|fail| failed[APPLICATION_FAILED]
    validate -->|pass| applied[EXPERIENCE_APPLIED]

    MODEL_READY_GATE[MODEL_READY gate] -.-> task
    MODEL_READY_GATE -.->|not waiting on MEL| learned

    subgraph training [Training evidence]
        A[Dataset A Music Center TRAINING_EXPERIENCE]
        B[Dataset B Stride and Field LEARNING_EVIDENCE]
    end
    subgraph holdout [Sealed holdout]
        C[Dataset C Summit and Pine SEALED_HOLDOUT]
        C --> cBase[DOMAIN_VIEW v1 baseline sealed]
    end
    A --> closeEp
    B --> closeEp
    C -.->|never candidate or promotion evidence| extract
    learned --> v2[DOMAIN_VIEW v2 if promoted]
    v2 --> cApply[Same Dataset C application test]
    cBase --> cApply
    cApply --> applied

